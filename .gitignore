# data is local-only: raw pulls are immutable and re-fetchable via pipelines,
# the DB is rebuilt by naru. Directory structure is kept via .gitkeep.
data/raw/**
!data/raw/.gitkeep
data/db/**
!data/db/.gitkeep

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

# secrets: API keys never enter git (CLAUDE.md rule 4). Loaded at fetch time
# from a gitignored .env; pipelines read os.environ, never a hardcoded value.
.env
*.key

# OS
.DS_Store
